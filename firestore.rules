rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email.lower() == 'shaiklatheef2608@gmail.com';
    }

    function isWhitelistedHostEmail(email) {
      return email != null && email.lower() in [
        'ist@nbkrist.org',
        'istenbkrist@nbkrist.org',
        'istesbnbkrist@nbkrist.org',
        'uhvcellnbkrist@nbkrist.org',
        'ieeesbnbkrist@nbkrist.org',
        'iicnbkrist@nbkrist.org',
        'csenbkrist@nbkrist.org',
        'mechnbkrist@nbkrist.org',
        'eeenbkrist@nbkrist.org',
        'ecenbkrist@nbkrist.org',
        'aidsnbkrist@nbkrist.org',
        'civilnbkrist@nbkrist.org',
        'shaiklatheef2608@gmail.com'
      ];
    }

    function getApprovedHostDoc(email) {
      return get(/databases/$(database)/documents/approvedHosts/$(email)).data;
    }

    // Health check endpoint
    match /test/connection {
      allow read: if true;
    }

    // Whitelist registry
    match /approvedHosts/{email} {
      allow get, list: if true;
      allow create, update: if isSuperAdmin() || (isSignedIn() && isWhitelistedHostEmail(email));
      allow delete: if false;
    }

    // Host profiles
    match /hosts/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin() || ('email' in request.auth.token && isWhitelistedHostEmail(request.auth.token.email)));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && 
        request.auth.uid == uid &&
        'email' in request.auth.token &&
        exists(/databases/$(database)/documents/approvedHosts/$(request.auth.token.email.lower())) &&
        getApprovedHostDoc(request.auth.token.email.lower()).approved == true &&
        request.resource.data.uid == uid &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.approved == true &&
        request.resource.data.organization == getApprovedHostDoc(request.auth.token.email.lower()).organization &&
        request.resource.data.hostType == getApprovedHostDoc(request.auth.token.email.lower()).hostType;

      allow update: if isSignedIn() && 
        (request.auth.uid == uid || isSuperAdmin()) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email.lower() == resource.data.email.lower() &&
        request.resource.data.organization == resource.data.organization &&
        request.resource.data.hostType == resource.data.hostType &&
        request.resource.data.approved == resource.data.approved;

      allow delete: if false;
    }

    // General user profiles (students/attendees)
    match /users/{uid} {
      allow get, update, delete: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow list: if false;

      // Participant's own registrations index
      match /registrations/{regId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Institutional Events: Public can browse published events
    match /events/{eventId} {
      allow get, list: if true;

      allow create: if isSignedIn() && 
        'email' in request.auth.token &&
        (isWhitelistedHostEmail(request.auth.token.email) || isSuperAdmin()) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.organization is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.posterUrl is string &&
        request.resource.data.posterUrl.size() >= 10;

      allow update: if isSignedIn() && 
        'email' in request.auth.token &&
        (resource.data.createdBy == request.auth.uid || isWhitelistedHostEmail(request.auth.token.email) || isSuperAdmin()) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.posterUrl is string &&
        request.resource.data.posterUrl.size() >= 10;

      allow delete: if isSignedIn() && 
        'email' in request.auth.token &&
        (resource.data.createdBy == request.auth.uid || isWhitelistedHostEmail(request.auth.token.email) || isSuperAdmin());

      // Registration Form definitions
      match /registrationForms/{formId} {
        // Public can read published form definition
        allow get, list: if true;
        // Only the host who created the parent event or superadmin can write form definitions
        allow create, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          isSuperAdmin()
        );
      }

      // Registrations
      match /registrations/{registrationId} {
        // Participant can read their own registration; host of the event or superadmin can read all registrations for this event
        allow get: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          isSuperAdmin()
        );

        // Host of the event or superadmin can list all registrations for this event
        // Participant can list their own registrations
        allow list: if isSignedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          isSuperAdmin() ||
          request.query.limit <= 50
        );

        // Authenticated participant can create their own registration
        allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.eventId == eventId;

        // Host or superadmin can update payment status or verification
        // Participant can update only their own registration (e.g. submit transaction ID)
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          isSuperAdmin() ||
          (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
        );

        // Only host or superadmin can delete a registration
        allow delete: if isSignedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
          isSuperAdmin()
        );
      }
    }
  }
}
